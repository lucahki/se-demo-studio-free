# Optional: an OpenRouter key, used only for the paid OpenRouter narration voice when a job's owner picks it.
# Nothing else in this studio uses it; the Kokoro and Chatterbox voices need no key.
# Create one at https://openrouter.ai/settings/keys (set a credit limit on it), paste it after the = sign,
# and save. Never paste the key into the Claude chat.
OPENROUTER_API_KEY=

# Optional: a Google AI Studio key, used only for the Gemini voice (narration or a two-speaker call) when a job's
# owner picks it. Nothing else in this studio uses it. Create one at https://aistudio.google.com/apikey (the free
# tier needs no card), paste it right after the = sign on the same line, and save. Never paste the key into the
# Claude chat.
GEMINI_API_KEY=
